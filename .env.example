# === Universal MCP — Configuración por variables de entorno ===
# Copia este archivo como `.env` y ajusta lo que necesites.

# Identidad del servidor (visible por el cliente MCP)
MCP_SERVER_NAME=universal-mcp

# Transporte: stdio | streamable-http | sse
#   stdio            → para Claude Desktop / CLI (por defecto)
#   streamable-http  → para acceso remoto/HTTP (endpoint /mcp)
#   sse              → legado (Server-Sent Events)
MCP_TRANSPORT=stdio

# Host/puerto usados por los transportes HTTP
MCP_HOST=127.0.0.1
MCP_PORT=8000

# Nivel de log: DEBUG | INFO | WARNING | ERROR
MCP_LOG_LEVEL=INFO

# Módulos a desactivar, separados por coma (ej.: system,ai)
MCP_DISABLED_MODULES=

# Directorios adicionales de plugins externos, separados por coma
# (desactivados salvo configuración explícita; se ejecutan in-process)
MCP_PLUGIN_DIRS=

# Permisos por herramienta (v0.2): globs sobre el nombre final.
# ALLOWED vacío = todas permitidas; BLOCKED siempre gana sobre ALLOWED.
MCP_ALLOWED_TOOLS=
MCP_BLOCKED_TOOLS=

# Directorio sandbox para las tools de archivos/datos
MCP_WORKSPACE_DIR=./workspace

# Habilitar la tool system_run_command (¡solo en entornos confiables!)
MCP_ENABLE_SHELL=false

# Seguridad HTTP: bloquear URLs hacia IPs privadas/loopback (anti-SSRF).
# En v0.2 cada hop de redirección también se re-valida.
MCP_HTTP_BLOCK_PRIVATE=true

# Timeout por defecto para peticiones HTTP (segundos)
MCP_HTTP_TIMEOUT=15

# Máximo de caracteres devueltos en cuerpos de respuesta HTTP
MCP_MAX_OUTPUT_CHARS=20000
